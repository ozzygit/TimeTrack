<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window / surface backgrounds — pure black for maximum contrast -->
    <SolidColorBrush x:Key="WindowBackground"          Color="#000000"/>
    <SolidColorBrush x:Key="BackgroundBrush"           Color="#000000"/>
    <SolidColorBrush x:Key="ContextMenuBackground"     Color="#000000"/>

    <!-- Accent / primary — bright white on black -->
    <SolidColorBrush x:Key="PrimaryBrush"              Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"         Color="#CCCCCC"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush"       Color="#999999"/>
    <SolidColorBrush x:Key="AccentBrush"               Color="#FFFF00"/>
    <SolidColorBrush x:Key="PrimaryForegroundBrush"    Color="#000000"/>

    <!-- Borders — bright white for maximum visibility -->
    <SolidColorBrush x:Key="BorderBrush"               Color="#FFFFFF"/>

    <!-- Text — pure white -->
    <SolidColorBrush x:Key="TextBrush"                 Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SubtleBrush"               Color="#CCCCCC"/>

    <!-- Button states -->
    <SolidColorBrush x:Key="ButtonHoverBrush"          Color="#333333"/>
    <SolidColorBrush x:Key="ButtonPressedBrush"        Color="#555555"/>
    <SolidColorBrush x:Key="ButtonHoverBorderBrush"    Color="#FFFFFF"/>

    <!-- TextBox states -->
    <SolidColorBrush x:Key="TextBoxHoverBorderBrush"   Color="#FFFF00"/>

    <!-- DataGrid -->
    <SolidColorBrush x:Key="DataGridRowHoverBrush"     Color="#333333"/>
    <SolidColorBrush x:Key="DataGridRowSelectedBrush"  Color="#555555"/>
    <SolidColorBrush x:Key="DataGridGridLineBrush"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DataGridAltRowBrush"       Color="#111111"/>
    <SolidColorBrush x:Key="DataGridHeaderBackground"  Color="#222222"/>

    <!-- Tabs -->
    <SolidColorBrush x:Key="TabInactiveBrush"          Color="#222222"/>
    <SolidColorBrush x:Key="TabHoverBrush"             Color="#444444"/>
    <SolidColorBrush x:Key="TabAccentBarBrush"         Color="#FFFF00"/>

    <!-- CheckBox states -->
    <SolidColorBrush x:Key="CheckBoxCheckedBrush"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CheckBoxHoverBrush"        Color="#333333"/>
    <SolidColorBrush x:Key="CheckBoxHoverCheckedBrush" Color="#CCCCCC"/>

    <!-- Context menu -->
    <SolidColorBrush x:Key="ContextMenuItemHoverBrush" Color="#555555"/>

    <!-- Settings nav sidebar -->
    <SolidColorBrush x:Key="NavButtonHoverBrush"       Color="#333333"/>
    <SolidColorBrush x:Key="NavButtonSelectedBrush"    Color="#555555"/>

    <!-- Not-today date highlight -->
    <SolidColorBrush x:Key="NotTodayHighlightBrush"   Color="#FF0000"/>

    <!-- Disabled input background -->
    <SolidColorBrush x:Key="DisabledInputBrush"        Color="#222222"/>

    <!-- Timer colour coding — high contrast variants -->
    <SolidColorBrush x:Key="TimerNormalBrush"          Color="#00FF00"/>
    <SolidColorBrush x:Key="TimerCautionBrush"         Color="#FFFF00"/>
    <SolidColorBrush x:Key="TimerWarningBrush"         Color="#FF0000"/>

    <!-- Calendar -->
    <SolidColorBrush x:Key="CalendarDayForeground"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CalendarBlackoutForeground" Color="#666666"/>
    <SolidColorBrush x:Key="CalendarTodayBorder"       Color="#FF0000"/>
    <SolidColorBrush x:Key="CalendarHeaderForeground"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CalendarMonthForeground"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CalendarDayHover"          Color="#333333"/>
    <SolidColorBrush x:Key="CalendarDaySelected"       Color="#555555"/>

</ResourceDictionary>
