<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window / surface backgrounds -->
    <SolidColorBrush x:Key="WindowBackground"          Color="#1E1E1E"/>
    <SolidColorBrush x:Key="BackgroundBrush"           Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ContextMenuBackground"     Color="#2A2A2A"/>

    <!-- Accent / primary — dimmed Monokai green (#888f88 muted) -->
    <SolidColorBrush x:Key="PrimaryBrush"              Color="#6A9F5A"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"         Color="#7AAF6A"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush"       Color="#588048"/>
    <SolidColorBrush x:Key="AccentBrush"               Color="#6A9F5A"/>
    <SolidColorBrush x:Key="PrimaryForegroundBrush"    Color="#F8F8F0"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"               Color="#3A3A3A"/>

    <!-- Text — dimmed Monokai foreground -->
    <SolidColorBrush x:Key="TextBrush"                 Color="#C5C8C6"/>
    <SolidColorBrush x:Key="SubtleBrush"               Color="#8C8C8C"/>

    <!-- Button states -->
    <SolidColorBrush x:Key="ButtonHoverBrush"          Color="#353535"/>
    <SolidColorBrush x:Key="ButtonPressedBrush"        Color="#404040"/>
    <SolidColorBrush x:Key="ButtonHoverBorderBrush"    Color="#555555"/>

    <!-- TextBox states -->
    <SolidColorBrush x:Key="TextBoxHoverBorderBrush"   Color="#555555"/>

    <!-- DataGrid -->
    <SolidColorBrush x:Key="DataGridRowHoverBrush"     Color="#333333"/>
    <SolidColorBrush x:Key="DataGridRowSelectedBrush"  Color="#3D3D3D"/>
    <SolidColorBrush x:Key="DataGridGridLineBrush"     Color="#333333"/>
    <SolidColorBrush x:Key="DataGridAltRowBrush"       Color="#252525"/>
    <SolidColorBrush x:Key="DataGridHeaderBackground"  Color="#303030"/>

    <!-- Tabs -->
    <SolidColorBrush x:Key="TabInactiveBrush"          Color="#333333"/>
    <SolidColorBrush x:Key="TabHoverBrush"             Color="#3D3D3D"/>
    <SolidColorBrush x:Key="TabAccentBarBrush"         Color="#6A9F5A"/>

    <!-- CheckBox states -->
    <SolidColorBrush x:Key="CheckBoxCheckedBrush"      Color="#3D3D3D"/>
    <SolidColorBrush x:Key="CheckBoxHoverBrush"        Color="#353535"/>
    <SolidColorBrush x:Key="CheckBoxHoverCheckedBrush" Color="#454545"/>

    <!-- Context menu -->
    <SolidColorBrush x:Key="ContextMenuItemHoverBrush" Color="#3D3D3D"/>

    <!-- Settings nav sidebar -->
    <SolidColorBrush x:Key="NavButtonHoverBrush"       Color="#353535"/>
    <SolidColorBrush x:Key="NavButtonSelectedBrush"    Color="#3D3D3D"/>

    <!-- Not-today date highlight — dimmed Monokai orange (#fd971f muted) -->
    <SolidColorBrush x:Key="NotTodayHighlightBrush"   Color="#D68D3A"/>

    <!-- Disabled input background -->
    <SolidColorBrush x:Key="DisabledInputBrush"        Color="#383838"/>

    <!-- Timer colour coding -->
    <SolidColorBrush x:Key="TimerNormalBrush"          Color="#A6E22E"/>
    <SolidColorBrush x:Key="TimerCautionBrush"         Color="#FD971F"/>
    <SolidColorBrush x:Key="TimerWarningBrush"         Color="#F92672"/>

    <!-- Calendar -->
    <SolidColorBrush x:Key="CalendarDayForeground"     Color="#C5C8C6"/>
    <SolidColorBrush x:Key="CalendarBlackoutForeground" Color="#555555"/>
    <SolidColorBrush x:Key="CalendarTodayBorder"       Color="#D68D3A"/>
    <SolidColorBrush x:Key="CalendarHeaderForeground"  Color="#C5C8C6"/>
    <SolidColorBrush x:Key="CalendarMonthForeground"   Color="#A0A0A0"/>
    <SolidColorBrush x:Key="CalendarDayHover"          Color="#353535"/>
    <SolidColorBrush x:Key="CalendarDaySelected"       Color="#3D3D3D"/>

</ResourceDictionary>
