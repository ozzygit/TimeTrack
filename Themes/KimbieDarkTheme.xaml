<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window / surface backgrounds — warm dark brown -->
    <SolidColorBrush x:Key="WindowBackground"          Color="#221A0F"/>
    <SolidColorBrush x:Key="BackgroundBrush"           Color="#2D2620"/>
    <SolidColorBrush x:Key="ContextMenuBackground"     Color="#2D2620"/>

    <!-- Accent / primary — Kimbie amber #f0a040 -->
    <SolidColorBrush x:Key="PrimaryBrush"              Color="#D59340"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"         Color="#E5A350"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush"       Color="#B07830"/>
    <SolidColorBrush x:Key="AccentBrush"               Color="#D59340"/>
    <SolidColorBrush x:Key="PrimaryForegroundBrush"    Color="#1A140A"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"               Color="#3D332A"/>

    <!-- Text — warm cream -->
    <SolidColorBrush x:Key="TextBrush"                 Color="#D3C9B3"/>
    <SolidColorBrush x:Key="SubtleBrush"               Color="#8A7C6A"/>

    <!-- Button states -->
    <SolidColorBrush x:Key="ButtonHoverBrush"          Color="#382F25"/>
    <SolidColorBrush x:Key="ButtonPressedBrush"        Color="#423830"/>
    <SolidColorBrush x:Key="ButtonHoverBorderBrush"    Color="#5A4D40"/>

    <!-- TextBox states -->
    <SolidColorBrush x:Key="TextBoxHoverBorderBrush"   Color="#5A4D40"/>

    <!-- DataGrid -->
    <SolidColorBrush x:Key="DataGridRowHoverBrush"     Color="#352C22"/>
    <SolidColorBrush x:Key="DataGridRowSelectedBrush"  Color="#3D332A"/>
    <SolidColorBrush x:Key="DataGridGridLineBrush"     Color="#352C22"/>
    <SolidColorBrush x:Key="DataGridAltRowBrush"       Color="#282018"/>
    <SolidColorBrush x:Key="DataGridHeaderBackground"  Color="#332A20"/>

    <!-- Tabs -->
    <SolidColorBrush x:Key="TabInactiveBrush"          Color="#352C22"/>
    <SolidColorBrush x:Key="TabHoverBrush"             Color="#3D332A"/>
    <SolidColorBrush x:Key="TabAccentBarBrush"         Color="#D59340"/>

    <!-- CheckBox states -->
    <SolidColorBrush x:Key="CheckBoxCheckedBrush"      Color="#3D332A"/>
    <SolidColorBrush x:Key="CheckBoxHoverBrush"        Color="#382F25"/>
    <SolidColorBrush x:Key="CheckBoxHoverCheckedBrush" Color="#4A3D30"/>

    <!-- Context menu -->
    <SolidColorBrush x:Key="ContextMenuItemHoverBrush" Color="#3D332A"/>

    <!-- Settings nav sidebar -->
    <SolidColorBrush x:Key="NavButtonHoverBrush"       Color="#382F25"/>
    <SolidColorBrush x:Key="NavButtonSelectedBrush"    Color="#3D332A"/>

    <!-- Not-today date highlight — Kimbie red #dc322f muted -->
    <SolidColorBrush x:Key="NotTodayHighlightBrush"   Color="#C04030"/>

    <!-- Disabled input background -->
    <SolidColorBrush x:Key="DisabledInputBrush"        Color="#3A3025"/>

    <!-- Calendar -->
    <SolidColorBrush x:Key="CalendarDayForeground"     Color="#D3C9B3"/>
    <SolidColorBrush x:Key="CalendarBlackoutForeground" Color="#6A5C4A"/>
    <SolidColorBrush x:Key="CalendarTodayBorder"       Color="#C04030"/>
    <SolidColorBrush x:Key="CalendarHeaderForeground"  Color="#D3C9B3"/>
    <SolidColorBrush x:Key="CalendarMonthForeground"   Color="#A89C85"/>
    <SolidColorBrush x:Key="CalendarDayHover"          Color="#382F25"/>
    <SolidColorBrush x:Key="CalendarDaySelected"       Color="#3D332A"/>

</ResourceDictionary>
