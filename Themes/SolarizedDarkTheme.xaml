<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window / surface backgrounds — Solarized base03 -->
    <SolidColorBrush x:Key="WindowBackground"          Color="#002B36"/>
    <SolidColorBrush x:Key="BackgroundBrush"           Color="#073642"/>
    <SolidColorBrush x:Key="ContextMenuBackground"     Color="#073642"/>

    <!-- Accent / primary — Solarized blue #268bd2 -->
    <SolidColorBrush x:Key="PrimaryBrush"              Color="#268BD2"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"         Color="#3A9DE0"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush"       Color="#1A6BA8"/>
    <SolidColorBrush x:Key="AccentBrush"               Color="#268BD2"/>
    <SolidColorBrush x:Key="PrimaryForegroundBrush"    Color="#002B36"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"               Color="#0D4654"/>

    <!-- Text — Solarized base0 / base00 -->
    <SolidColorBrush x:Key="TextBrush"                 Color="#93A1A1"/>
    <SolidColorBrush x:Key="SubtleBrush"               Color="#657B83"/>

    <!-- Button states -->
    <SolidColorBrush x:Key="ButtonHoverBrush"          Color="#0D4654"/>
    <SolidColorBrush x:Key="ButtonPressedBrush"        Color="#135262"/>
    <SolidColorBrush x:Key="ButtonHoverBorderBrush"    Color="#2A6678"/>

    <!-- TextBox states -->
    <SolidColorBrush x:Key="TextBoxHoverBorderBrush"   Color="#2A6678"/>

    <!-- DataGrid -->
    <SolidColorBrush x:Key="DataGridRowHoverBrush"     Color="#0D4654"/>
    <SolidColorBrush x:Key="DataGridRowSelectedBrush"  Color="#135262"/>
    <SolidColorBrush x:Key="DataGridGridLineBrush"     Color="#0D4654"/>
    <SolidColorBrush x:Key="DataGridAltRowBrush"       Color="#053340"/>
    <SolidColorBrush x:Key="DataGridHeaderBackground"  Color="#0D4654"/>

    <!-- Tabs -->
    <SolidColorBrush x:Key="TabInactiveBrush"          Color="#0D4654"/>
    <SolidColorBrush x:Key="TabHoverBrush"             Color="#135262"/>
    <SolidColorBrush x:Key="TabAccentBarBrush"         Color="#268BD2"/>

    <!-- CheckBox states -->
    <SolidColorBrush x:Key="CheckBoxCheckedBrush"      Color="#135262"/>
    <SolidColorBrush x:Key="CheckBoxHoverBrush"        Color="#0D4654"/>
    <SolidColorBrush x:Key="CheckBoxHoverCheckedBrush" Color="#1A5E72"/>

    <!-- Context menu -->
    <SolidColorBrush x:Key="ContextMenuItemHoverBrush" Color="#135262"/>

    <!-- Settings nav sidebar -->
    <SolidColorBrush x:Key="NavButtonHoverBrush"       Color="#0D4654"/>
    <SolidColorBrush x:Key="NavButtonSelectedBrush"    Color="#135262"/>

    <!-- Not-today date highlight — Solarized orange #cb4b16 -->
    <SolidColorBrush x:Key="NotTodayHighlightBrush"   Color="#CB4B16"/>

    <!-- Disabled input background -->
    <SolidColorBrush x:Key="DisabledInputBrush"        Color="#0A3A48"/>

    <!-- Timer colour coding -->
    <SolidColorBrush x:Key="TimerNormalBrush"          Color="#859900"/>
    <SolidColorBrush x:Key="TimerCautionBrush"         Color="#B58900"/>
    <SolidColorBrush x:Key="TimerWarningBrush"         Color="#DC322F"/>

    <!-- Calendar -->
    <SolidColorBrush x:Key="CalendarDayForeground"     Color="#93A1A1"/>
    <SolidColorBrush x:Key="CalendarBlackoutForeground" Color="#586E75"/>
    <SolidColorBrush x:Key="CalendarTodayBorder"       Color="#CB4B16"/>
    <SolidColorBrush x:Key="CalendarHeaderForeground"  Color="#93A1A1"/>
    <SolidColorBrush x:Key="CalendarMonthForeground"   Color="#839496"/>
    <SolidColorBrush x:Key="CalendarDayHover"          Color="#0D4654"/>
    <SolidColorBrush x:Key="CalendarDaySelected"       Color="#135262"/>

</ResourceDictionary>
