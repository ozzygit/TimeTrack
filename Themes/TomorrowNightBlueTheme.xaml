<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window / surface backgrounds — deep blue -->
    <SolidColorBrush x:Key="WindowBackground"          Color="#002451"/>
    <SolidColorBrush x:Key="BackgroundBrush"           Color="#00346E"/>
    <SolidColorBrush x:Key="ContextMenuBackground"     Color="#00346E"/>

    <!-- Accent / primary — Tomorrow Night Blue blue #7fb0ff -->
    <SolidColorBrush x:Key="PrimaryBrush"              Color="#5F9CFF"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"         Color="#7FB0FF"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush"       Color="#4A80E0"/>
    <SolidColorBrush x:Key="AccentBrush"               Color="#5F9CFF"/>
    <SolidColorBrush x:Key="PrimaryForegroundBrush"    Color="#002451"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"               Color="#004A8E"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush"                 Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SubtleBrush"               Color="#7C8DB5"/>

    <!-- Button states -->
    <SolidColorBrush x:Key="ButtonHoverBrush"          Color="#004A8E"/>
    <SolidColorBrush x:Key="ButtonPressedBrush"        Color="#005AA8"/>
    <SolidColorBrush x:Key="ButtonHoverBorderBrush"    Color="#2A6FB5"/>

    <!-- TextBox states -->
    <SolidColorBrush x:Key="TextBoxHoverBorderBrush"   Color="#2A6FB5"/>

    <!-- DataGrid -->
    <SolidColorBrush x:Key="DataGridRowHoverBrush"     Color="#004A8E"/>
    <SolidColorBrush x:Key="DataGridRowSelectedBrush"  Color="#005AA8"/>
    <SolidColorBrush x:Key="DataGridGridLineBrush"     Color="#004A8E"/>
    <SolidColorBrush x:Key="DataGridAltRowBrush"       Color="#002E60"/>
    <SolidColorBrush x:Key="DataGridHeaderBackground"  Color="#004A8E"/>

    <!-- Tabs -->
    <SolidColorBrush x:Key="TabInactiveBrush"          Color="#004A8E"/>
    <SolidColorBrush x:Key="TabHoverBrush"             Color="#005AA8"/>
    <SolidColorBrush x:Key="TabAccentBarBrush"         Color="#5F9CFF"/>

    <!-- CheckBox states -->
    <SolidColorBrush x:Key="CheckBoxCheckedBrush"      Color="#005AA8"/>
    <SolidColorBrush x:Key="CheckBoxHoverBrush"        Color="#004A8E"/>
    <SolidColorBrush x:Key="CheckBoxHoverCheckedBrush" Color="#006ABF"/>

    <!-- Context menu -->
    <SolidColorBrush x:Key="ContextMenuItemHoverBrush" Color="#005AA8"/>

    <!-- Settings nav sidebar -->
    <SolidColorBrush x:Key="NavButtonHoverBrush"       Color="#004A8E"/>
    <SolidColorBrush x:Key="NavButtonSelectedBrush"    Color="#005AA8"/>

    <!-- Not-today date highlight — Tomorrow Night Blue red #ff6c60 -->
    <SolidColorBrush x:Key="NotTodayHighlightBrush"   Color="#FF6C60"/>

    <!-- Disabled input background -->
    <SolidColorBrush x:Key="DisabledInputBrush"        Color="#003E78"/>

    <!-- Calendar -->
    <SolidColorBrush x:Key="CalendarDayForeground"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CalendarBlackoutForeground" Color="#5C70A0"/>
    <SolidColorBrush x:Key="CalendarTodayBorder"       Color="#FF6C60"/>
    <SolidColorBrush x:Key="CalendarHeaderForeground"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CalendarMonthForeground"   Color="#B0BFE0"/>
    <SolidColorBrush x:Key="CalendarDayHover"          Color="#004A8E"/>
    <SolidColorBrush x:Key="CalendarDaySelected"       Color="#005AA8"/>

</ResourceDictionary>
