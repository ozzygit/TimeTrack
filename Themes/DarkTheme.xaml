<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window / surface backgrounds -->
    <SolidColorBrush x:Key="WindowBackground"          Color="#202020"/>
    <SolidColorBrush x:Key="BackgroundBrush"           Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ContextMenuBackground"     Color="#2D2D2D"/>

    <!-- Accent / primary -->
    <SolidColorBrush x:Key="PrimaryBrush"              Color="#60CDFF"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"         Color="#81D4FA"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush"       Color="#0091CC"/>
    <SolidColorBrush x:Key="AccentBrush"               Color="#60CDFF"/>
    <SolidColorBrush x:Key="PrimaryForegroundBrush"    Color="#0A1929"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"               Color="#404040"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush"                 Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SubtleBrush"               Color="#ACACAC"/>

    <!-- Button states -->
    <SolidColorBrush x:Key="ButtonHoverBrush"          Color="#3E3E3E"/>
    <SolidColorBrush x:Key="ButtonPressedBrush"        Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ButtonHoverBorderBrush"    Color="#606060"/>

    <!-- TextBox states -->
    <SolidColorBrush x:Key="TextBoxHoverBorderBrush"   Color="#606060"/>

    <!-- DataGrid -->
    <SolidColorBrush x:Key="DataGridRowHoverBrush"     Color="#383838"/>
    <SolidColorBrush x:Key="DataGridRowSelectedBrush"  Color="#1A3A50"/>
    <SolidColorBrush x:Key="DataGridGridLineBrush"     Color="#383838"/>
    <SolidColorBrush x:Key="DataGridAltRowBrush"       Color="#323232"/>
    <SolidColorBrush x:Key="DataGridHeaderBackground"  Color="#3D3D3D"/>

    <!-- Tabs -->
    <SolidColorBrush x:Key="TabInactiveBrush"          Color="#383838"/>
    <SolidColorBrush x:Key="TabHoverBrush"             Color="#454545"/>
    <SolidColorBrush x:Key="TabAccentBarBrush"         Color="#60CDFF"/>

    <!-- CheckBox states -->
    <SolidColorBrush x:Key="CheckBoxCheckedBrush"      Color="#1A3A50"/>
    <SolidColorBrush x:Key="CheckBoxHoverBrush"        Color="#3A3A3A"/>
    <SolidColorBrush x:Key="CheckBoxHoverCheckedBrush" Color="#1E4A68"/>

    <!-- Context menu -->
    <SolidColorBrush x:Key="ContextMenuItemHoverBrush" Color="#1A3A50"/>

    <!-- Settings nav sidebar -->
    <SolidColorBrush x:Key="NavButtonHoverBrush"       Color="#3E3E3E"/>
    <SolidColorBrush x:Key="NavButtonSelectedBrush"    Color="#1A3A50"/>

    <!-- Not-today date highlight -->
    <SolidColorBrush x:Key="NotTodayHighlightBrush"   Color="#8B3000"/>

    <!-- Disabled input background -->
    <SolidColorBrush x:Key="DisabledInputBrush"        Color="#3A3A3A"/>

    <!-- Calendar -->
    <SolidColorBrush x:Key="CalendarDayForeground"     Color="#E0E0E0"/>
    <SolidColorBrush x:Key="CalendarBlackoutForeground" Color="#666666"/>
    <SolidColorBrush x:Key="CalendarTodayBorder"       Color="#FF4444"/>
    <SolidColorBrush x:Key="CalendarHeaderForeground"  Color="#F3F3F3"/>
    <SolidColorBrush x:Key="CalendarMonthForeground"   Color="#CCCCCC"/>
    <SolidColorBrush x:Key="CalendarDayHover"          Color="#3E3E3E"/>
    <SolidColorBrush x:Key="CalendarDaySelected"       Color="#1A3A50"/>

</ResourceDictionary>
