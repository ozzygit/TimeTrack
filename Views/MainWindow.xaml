<Window x:Class="TimeTrack.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:data="clr-namespace:TimeTrack.Data"
        xmlns:views="clr-namespace:TimeTrack.Views"
        xmlns:viewModels="clr-namespace:TimeTrack.ViewModels"
        xmlns:converters="clr-namespace:TimeTrack.Converters"
        xmlns:utils="clr-namespace:TimeTrack.Utilities"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:TimeKeeperViewModel, IsDesignTimeCreatable=False}"
        Title="{x:Static utils:AppVersion.MainWindowTitle}" Height="675" Width="800" MinWidth="700" MinHeight="500"
        Icon="/Resources/time.png" Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <data:TimeEntryUIConverter x:Key="TimeEntryUIConverter"/>
        <converters:ShortcutDisplayConverter x:Key="ShortcutDisplayConverter"/>

        <!-- Calendar Day Button Style (theme-aware + red border on today) -->
        <Style x:Key="CalendarDayButtonStyle" TargetType="CalendarDayButton">
            <Setter Property="Foreground" Value="{DynamicResource CalendarDayForeground}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Grid>
                            <Border x:Name="DayBorder"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <ContentPresenter x:Name="DayContent"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="2"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsBlackedOut" Value="True">
                                <Setter TargetName="DayContent" Property="TextBlock.Foreground" Value="{DynamicResource CalendarBlackoutForeground}"/>
                                <Setter TargetName="DayContent" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource CalendarTodayBorder}"/>
                                <Setter TargetName="DayBorder" Property="BorderThickness" Value="2"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource CalendarDaySelected}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsBlackedOut" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource CalendarDayHover}"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsToday" Value="True"/>
                                    <Condition Property="IsSelected" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource CalendarDaySelected}"/>
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource CalendarTodayBorder}"/>
                                <Setter TargetName="DayBorder" Property="BorderThickness" Value="2"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Calendar Month/Year Button Style (theme-aware) -->
        <Style x:Key="CalendarButtonStyle" TargetType="CalendarButton">
            <Setter Property="Foreground" Value="{DynamicResource CalendarMonthForeground}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarButton">
                        <Border x:Name="MonthBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MonthBorder" Property="Background" Value="{DynamicResource CalendarDayHover}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="MonthBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Calendar Item Style (theme-aware header + nav) -->
        <Style x:Key="CalendarItemStyle" TargetType="CalendarItem">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource CalendarHeaderForeground}"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>


        <!-- Modern Menu Styles -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="4"
                                Margin="2,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon (for submenus if needed) -->
                                <ContentPresenter x:Name="Icon"
                                                Grid.Column="0"
                                                Margin="6,0,6,0"
                                                VerticalAlignment="Center"
                                                ContentSource="Icon"/>

                                <!-- Header Text -->
                                <ContentPresenter x:Name="HeaderHost"
                                                Grid.Column="1"
                                                ContentSource="Header"
                                                Margin="{TemplateBinding Padding}"
                                                VerticalAlignment="Center"
                                                RecognizesAccessKey="True"/>

                                <!-- Input Gesture Text (Keyboard Shortcut) -->
                                <TextBlock x:Name="InputGestureText"
                                         Grid.Column="2"
                                         Text="{TemplateBinding InputGestureText}"
                                         Margin="20,0,10,0"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource SubtleBrush}"
                                         FontSize="12"/>

                                <!-- Submenu Arrow -->
                                <Path x:Name="ArrowPath"
                                    Grid.Column="3"
                                    Margin="4,0,6,0"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource TextBrush}"
                                    Data="M 0 0 L 4 4 L 0 8 Z"
                                    Visibility="Collapsed"/>

                                <!-- Popup for submenus -->
                                <Popup x:Name="PART_Popup"
                                     AllowsTransparency="True"
                                     Placement="Bottom"
                                     IsOpen="{TemplateBinding IsSubmenuOpen}"
                                     Focusable="False"
                                     PopupAnimation="Fade"
                                     VerticalOffset="2">
                                    <Border Background="{DynamicResource BackgroundBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          BorderThickness="1"
                                          CornerRadius="6"
                                          Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" Opacity="0.15" 
                                                            BlurRadius="12" ShadowDepth="4" Direction="270"/>
                                        </Border.Effect>
                                        <ScrollViewer Style="{DynamicResource {ComponentResourceKey 
                                                      TypeInTargetAssembly={x:Type FrameworkElement}, 
                                                      ResourceId=MenuScrollViewer}}"
                                                    MaxHeight="400">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                          Grid.IsSharedSizeScope="True"
                                                          Margin="0,4"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Top level menu item (File, Edit, etc.) -->
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                                <Setter TargetName="ArrowPath" Property="Visibility" Value="Collapsed"/>
                            </Trigger>

                            <!-- Submenu header (has children) -->
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                                <Setter TargetName="ArrowPath" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <!-- Mouse over effect -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <!-- Pressed effect -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                            </Trigger>

                            <!-- Submenu open effect for top level -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSubmenuOpen" Value="True"/>
                                    <Condition Property="Role" Value="TopLevelHeader"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                            </MultiTrigger>

                            <!-- Disabled state -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Separator Style -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{DynamicResource BorderBrush}" 
                              Height="1" 
                              Margin="32,4,8,4"
                              CornerRadius="0.5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern TextBlock Style -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Modern TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Focusable="False"
                                        Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource TextBoxHoverBorderBrush}"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DataGridGridLineBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource DataGridAltRowBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource DataGridHeaderBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <Thumb x:Name="PART_RightHeaderGripper"
                                   HorizontalAlignment="Right" Width="4"
                                   Cursor="SizeWE" Opacity="0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <EventSetter Event="MouseDoubleClick" Handler="DgRow_MouseDoubleClick"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="MinHeight" Value="34"/>
            <Style.Triggers>
                <!-- MouseOver on unselected rows only - must come BEFORE IsSelected -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsSelected" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource DataGridRowHoverBrush}"/>
                </MultiTrigger>
                <!-- Selected state - AFTER MouseOver so it takes precedence -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelectedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Override DataGridCell style to prevent cell borders and centre content vertically -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Keep cell background transparent when row is selected -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern DatePicker Style -->
        <Style TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <!-- Modern DataGrid CheckBox Style -->
        <Style x:Key="DataGridCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="CheckBoxBorder"
                                    Width="18"
                                    Height="18"
                                    Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="3">
                                <Path x:Name="CheckMark"
                                      Width="12"
                                      Height="12"
                                      Data="M 0,5 L 4,9 L 10,1"
                                      Stroke="{DynamicResource PrimaryBrush}"
                                      StrokeThickness="2.5"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"
                                      Stretch="Uniform"
                                      Margin="2"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Checked State -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource CheckBoxCheckedBrush}"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>

                            <!-- Mouse Over -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource CheckBoxHoverBrush}"/>
                            </Trigger>

                            <!-- Mouse Over + Checked -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource CheckBoxHoverCheckedBrush}"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
                            </MultiTrigger>

                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBoxBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style for Sections -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.05" 
                                    BlurRadius="8" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Notes Cell Text Style -->
        <Style x:Key="NotesCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="MaxHeight" Value="20"/>
            <Setter Property="ToolTip" Value="{Binding Notes}"/>
        </Style>

        <!-- Tab strip: label button (left portion of each tab) — flat flush style -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="MaxWidth" Value="130"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource TabInactiveBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,0,1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="AccentBar" Grid.Row="0" Background="Transparent"/>
                                <ContentPresenter Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource TabAccentBarBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,1,0,0"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab strip: close button (right portion of each tab) — flat flush style -->
        <Style x:Key="TabCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource TabInactiveBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="AccentBar" Grid.Row="0" Background="Transparent"/>
                                <ContentPresenter Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource TabAccentBarBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,1,1,0"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#D32F2F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Window caption button style -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Keyboard bindings are configured dynamically in MainWindow.xaml.cs via ApplyKeyboardShortcuts() -->
    <Window.InputBindings>
    </Window.InputBindings>

    <DockPanel>
        <!-- Custom Title Bar -->
        <Border DockPanel.Dock="Top" Height="32"
                Background="{DynamicResource WindowBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="/Resources/time.png"
                       Width="16" Height="16" Margin="10,0,0,0"
                       VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{x:Static utils:AppVersion.MainWindowTitle}"
                           FontFamily="Segoe UI" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,2,0">
                    <Button Name="BtnMinimize" Click="BtnMinimize_Click"
                            Style="{StaticResource CaptionButtonStyle}"
                            Width="36" Height="28" Content="&#xE949;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Foreground="{DynamicResource TextBrush}" Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Minimize"/>
                    <Button Name="BtnMaximize" Click="BtnMaximize_Click"
                            Style="{StaticResource CaptionButtonStyle}"
                            Width="36" Height="28" Content="&#xE740;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Foreground="{DynamicResource TextBrush}" Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Maximize"/>
                    <Button Name="BtnClose" Click="BtnClose_Click"
                            Style="{StaticResource CaptionButtonStyle}"
                            Width="36" Height="28" Content="&#xE8BB;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Foreground="{DynamicResource TextBrush}" Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource TabInactiveBrush}"
                Padding="0,0,0,0">
            <DockPanel>
                <!-- Settings + About icons on the right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource TabInactiveBrush}">
                    <Button Name="BtnSettings" Click="BtnSettings_Click"
                            Width="36" Height="30" Content="&#xE700;"
                            FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Background="{DynamicResource TabInactiveBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,0,1"
                            Foreground="{DynamicResource SubtleBrush}" Cursor="Hand"
                            ToolTip="Settings">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SettingsBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SettingsBorder" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Name="BtnAbout" Click="BtnAbout_Click"
                            Width="36" Height="30" Content="&#xE946;"
                            FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Background="{DynamicResource TabInactiveBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,1"
                            Foreground="{DynamicResource SubtleBrush}" Cursor="Hand"
                            ToolTip="About TimeTrack">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="AboutBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="AboutBorder" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly">
                <StackPanel Orientation="Horizontal">
                    <!-- Permanent Main tab — flat flush style -->
                    <Button Height="30" Margin="0" Padding="12,0" FontSize="12" Cursor="Hand"
                            Click="BtnMainTab" ToolTip="Main — entries log and date navigation">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource TabInactiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="2"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Border x:Name="AccentBar" Grid.Row="0" Background="Transparent"/>
                                                    <ContentPresenter Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Margin="{TemplateBinding Padding}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMainTabFocused}" Value="True">
                                                    <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource TabAccentBarBrush}"/>
                                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                                                    <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,1,1,0"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Main"/>
                    </Button>
                    <ItemsControl ItemsSource="{Binding OpenEntries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <Button Style="{StaticResource TabButtonStyle}"
                                            Tag="{Binding}" Click="BtnFocusTab"
                                            ToolTip="{Binding TicketDisplay}">
                                        <TextBlock Text="{Binding TabDisplay}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="140"/>
                                    </Button>
                                    <Button Style="{StaticResource TabCloseButtonStyle}"
                                            Tag="{Binding}" Click="BtnCloseTab"
                                            ToolTip="Close this entry">✕</Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Width="30" Height="30" Content="+" FontSize="14"
                            FontWeight="Bold" Padding="0" Margin="0,0,0,0"
                            Click="BtnNewEntry"
                            ToolTip="Start a new open entry">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource TabInactiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!--Status Bar - MOVED OUTSIDE ScrollViewer-->
        <StatusBar DockPanel.Dock="Bottom" Height="26"
                   Background="{DynamicResource BackgroundBrush}"
                   BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                   FontFamily="Segoe UI" FontSize="11"
                   Foreground="{DynamicResource SubtleBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"
                           Foreground="{DynamicResource SubtleBrush}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content Area (two-panel switcher) -->
        <Grid>
            <!-- MAIN TAB PANEL -->
            <Grid Visibility="{Binding IsMainTabFocused, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Stats row with date nav on left -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="12,12,12,8" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Date nav -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Grid>
                                <Button Name="DateButton" Click="DateButton_Click"
                                        Height="28" Padding="12,0"
                                        FontSize="13" Cursor="Hand"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource TextBoxHoverBorderBrush}"
                                        BorderThickness="1"
                                        ToolTip="Click to choose a date">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="DateBtnBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4">
                                                <TextBlock x:Name="DateText"
                                                           Text="{Binding CurrentDate}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Margin="{TemplateBinding Padding}"
                                                           FontSize="{TemplateBinding FontSize}"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DateBtnBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsViewingToday}" Value="False">
                                                    <Setter TargetName="DateText" Property="Foreground" Value="{DynamicResource NotTodayHighlightBrush}"/>
                                                    <Setter TargetName="DateText" Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup Name="DatePopup" Placement="Bottom"
                                       StaysOpen="False" AllowsTransparency="False"
                                       PopupAnimation="Slide">
                                    <Border Background="{DynamicResource BackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" Padding="0">
                                        <StackPanel>
                                            <Calendar Name="DateCalendar"
                                                      Margin="0"
                                                      Background="{DynamicResource BackgroundBrush}"
                                                      BorderBrush="Transparent"
                                                      BorderThickness="0"
                                                      CalendarDayButtonStyle="{StaticResource CalendarDayButtonStyle}"
                                                      CalendarButtonStyle="{StaticResource CalendarButtonStyle}"
                                                      CalendarItemStyle="{StaticResource CalendarItemStyle}"
                                                      SelectedDatesChanged="DateCalendar_SelectedDatesChanged"/>
                                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,1,0,0"/>
                                            <Button Name="CalendarTodayButton"
                                                    Click="CalendarToday_Click"
                                                    Height="30"
                                                    Background="{DynamicResource BackgroundBrush}"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    ToolTip="Jump to today's date"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="TOTAL" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SubtleBrush}" Margin="0,0,0,2"/>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding HoursTotal}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="GAPS" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SubtleBrush}" Margin="0,0,0,2"/>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding GapsTotal}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="BILLABLE" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SubtleBrush}" Margin="0,0,0,2"/>
                            <TextBlock FontSize="15" FontWeight="SemiBold">
                                <Run Text="{Binding BillableUnits}"/>
                                <Run Text=" units" Foreground="{DynamicResource SubtleBrush}" FontSize="12" FontWeight="Normal"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="SELECTED" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SubtleBrush}" Margin="0,0,0,2"/>
                            <TextBlock FontSize="15" FontWeight="SemiBold">
                                <Run Text="{Binding SelectedHours}"/>
                                <Run Text="h " Foreground="{DynamicResource SubtleBrush}" FontSize="12" FontWeight="Normal"/>
                                <Run Text="{Binding SelectedMins}"/>
                                <Run Text="m" Foreground="{DynamicResource SubtleBrush}" FontSize="12" FontWeight="Normal"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DataGrid -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="12,0,12,8" Padding="12">
                    <DataGrid Name="DgTimeRecords"
                             ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             AutoGenerateColumns="False"
                             HeadersVisibility="Column"
                             ColumnWidth="Auto"
                             RowHeaderWidth="0"
                             MinColumnWidth="40"
                             IsReadOnly="True"
                             EnableRowVirtualization="True"
                             EnableColumnVirtualization="True"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="DgTimeRecords_SelectionChanged"
                             PreviewMouseRightButtonDown="DgTimeRecords_PreviewMouseRightButtonDown">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Delete" Command="{x:Static views:MainWindow.DeleteCommand}"/>
                            <KeyBinding Key="A" Modifiers="Control" Command="{x:Static views:MainWindow.SelectAllCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Width="30"
                                Binding="{Binding Recorded, UpdateSourceTrigger=PropertyChanged}"
                                ElementStyle="{StaticResource DataGridCheckBoxStyle}"
                                EditingElementStyle="{StaticResource DataGridCheckBoxStyle}">
                                <DataGridCheckBoxColumn.Header>
                                    <CheckBox x:Name="ChkSelectAllHeader"
                                              Style="{StaticResource DataGridCheckBoxStyle}"
                                              Click="ChkSelectAllHeader_Click"
                                              ToolTip="Select all (Ctrl+A)"/>
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="Start" Width="82"
                                Binding="{Binding StartTime, Converter={StaticResource TimeEntryUIConverter}}"/>
                            <DataGridTextColumn Header="End" Width="82"
                                Binding="{Binding EndTime, Converter={StaticResource TimeEntryUIConverter}}"/>
                            <DataGridTextColumn Header="Units" Width="52" Binding="{Binding BillableUnits}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ticket Number" Width="140"
                                Binding="{Binding TicketNumber}"/>
                            <DataGridTextColumn Header="Notes" Width="*" Binding="{Binding Notes}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NotesCellTextStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="{DynamicResource ContextMenuBackground}" BorderBrush="{DynamicResource BorderBrush}"
                                         BorderThickness="1" Padding="0,4"
                                         FontFamily="Segoe UI" FontSize="13">
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" Opacity="0.12"
                                                                  BlurRadius="8" ShadowDepth="2" Direction="270"/>
                                            </Border.Effect>
                                            <ItemsPresenter SnapsToDevicePixels="True"/>
                                        </Border>
                                    </ControlTemplate>
                                </ContextMenu.Template>
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="Bd" Background="Transparent"
                                                            Padding="14,6">
                                                        <ContentPresenter ContentSource="Header"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ContextMenuItemHoverBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style TargetType="Separator">
                                        <Setter Property="Margin" Value="10,3"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Separator">
                                                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="Insert Record"
                                          Command="{x:Static views:MainWindow.InsertCommand}"
                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Delete Selected"
                                          Command="{x:Static views:MainWindow.DeleteCommand}"
                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Select All"
                                          Command="{x:Static views:MainWindow.SelectAllCommand}"
                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Border>

            </Grid>

            <!-- ENTRY TAB PANEL -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMainTabFocused}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Style="{StaticResource CardStyle}" Margin="12" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Fields row: horizontal layout -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="155"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Start Time -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Start Time" Style="{StaticResource LabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="FldStartTime" Grid.Column="0"
                                             Text="{Binding StartTimeField, UpdateSourceTrigger=PropertyChanged}"
                                             GotFocus="InputField_GotFocus"
                                             LostFocus="TimeField_LostFocus"
                                             PreviewKeyDown="TimeField_PreviewKeyDown"
                                             TabIndex="0"/>
                                    <Button Name="BtnNowStart" Grid.Column="2"
                                            Content="Now" FontSize="11" Padding="0"
                                            Click="BtnNowStart_Click"
                                            ToolTip="Set start time to current time"/>
                                </Grid>
                            </StackPanel>

                            <!-- End Time -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Finish Time" Style="{StaticResource LabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="FldEndTime" Grid.Column="0"
                                             Text="{Binding EndTimeField, UpdateSourceTrigger=PropertyChanged}"
                                             GotFocus="InputField_GotFocus"
                                             LostFocus="TimeField_LostFocus"
                                             PreviewKeyDown="TimeField_PreviewKeyDown"
                                             TabIndex="1"/>
                                    <Button Name="BtnNowEnd" Grid.Column="2"
                                            Content="Now" FontSize="11" Padding="0"
                                            Click="BtnNowEnd_Click"
                                            ToolTip="Set finish time to current time"/>
                                </Grid>
                            </StackPanel>

                            <!-- Ticket Number -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Ticket Number" Style="{StaticResource LabelStyle}"/>
                                <TextBox Name="FldTicketNumber"
                                         Text="{Binding TicketNumberField, UpdateSourceTrigger=PropertyChanged}"
                                         GotFocus="InputField_GotFocus"
                                         TabIndex="2"/>
                            </StackPanel>

                            <!-- Preset Dropdown -->
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Preset" Style="{StaticResource LabelStyle}"/>
                                <ComboBox Name="CmbPreset" TabIndex="5"
                                          SelectionChanged="CmbPreset_SelectionChanged"
                                          ToolTip="Select a preset to auto-fill ticket number and notes">
                                    <ComboBoxItem Content="—" IsSelected="True"/>
                                    <ComboBoxItem Content="Team Meeting"/>
                                    <ComboBoxItem Content="Internal Training"/>
                                    <ComboBoxItem Content="1 on 1"/>
                                    <ComboBoxItem Content="Break"/>
                                    <ComboBoxItem Content="Lunch"/>
                                </ComboBox>
                            </StackPanel>

                        </Grid>

                        <!-- Timer row: start/stop + split + live elapsed -->
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Name="BtnStartTimer" Grid.Column="0" Height="32" MinWidth="120"
                                    Content="▶  Start Timer"
                                    Click="BtnStartTimer_Click"
                                    ToolTip="Stamp start time and begin counting">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTimerRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Name="BtnStopTimer" Grid.Column="0" Height="32" MinWidth="120"
                                    Content="⏹  Stop Timer"
                                    Click="BtnStopTimer_Click"
                                    ToolTip="Stamp finish time and stop the timer">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTimerRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Name="BtnSplit" Grid.Column="2" Height="32" MinWidth="100"
                                    Content="⚡  Split"
                                    Click="BtnSplit_Click"
                                    ToolTip="End current entry and start new one">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMainTabFocused}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <TextBlock Grid.Column="3" Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="18" FontWeight="SemiBold"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       Text="{Binding TimerElapsedDisplay}"/>
                        </Grid>

                        <!-- Notes row: full width -->
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Notes" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="Enter detailed notes for this time entry"
                                               FontSize="11"
                                               Foreground="{DynamicResource SubtleBrush}"
                                               Margin="0,0,0,4"/>
                                </StackPanel>
                                <TextBox Grid.Row="1" Name="FldNotes"
                                         Text="{Binding NotesField, UpdateSourceTrigger=PropertyChanged}"
                                         GotFocus="InputField_GotFocus"
                                         TextWrapping="Wrap"
                                         MinHeight="120"
                                         AcceptsReturn="True"
                                         SpellCheck.IsEnabled="True"
                                         VerticalScrollBarVisibility="Auto"
                                         TabIndex="3"/>
                                <TextBlock Grid.Row="2" Text="{Binding NotesCharacterCount}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SubtleBrush}"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>
                                <TextBlock Grid.Row="3" Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SubtleBrush}"
                                           TextWrapping="Wrap">
                                    <Run Text="Tip: Press"/>
                                    <Run FontWeight="SemiBold" Text="Ctrl+Enter"/>
                                    <Run Text="to submit."/>
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <!-- Bottom row: duration · submit -->
                        <Grid Grid.Row="3" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding EntryDurationDisplay}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center"/>

                            <Button Name="BtnSub" Grid.Column="2" Height="36" MinWidth="130"
                                  TabIndex="4"
                                  Command="{x:Static views:MainWindow.SubmitCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsViewingToday}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource NotTodayHighlightBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource NotTodayHighlightBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Submit Entry" VerticalAlignment="Center"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="Normal"
                                             Margin="8,0,0,0" Opacity="0.8"
                                             Text="{Binding Path=., Mode=OneWay, Converter={StaticResource ShortcutDisplayConverter}, ConverterParameter=Submit}"/>
                                </StackPanel>
                                <Button.ToolTip>
                                    <TextBlock>
                                        <Run Text="Add a new time entry to the current day ("/>
                                        <Run Text="{Binding Path=., Mode=OneWay, Converter={StaticResource ShortcutDisplayConverter}, ConverterParameter=Submit}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </Button.ToolTip>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

