<Window x:Class="TimeTrack.Views.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - TimeTrack" Width="800" Height="600" MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        WindowStyle="None" ResizeMode="CanResizeWithGrip">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Navigation Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,3,0"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="IconText"
                                           FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{DynamicResource SubtleBrush}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource NavButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource NavButtonSelectedBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="IconText" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Section Description Style -->
        <Style x:Key="SectionDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Custom Title Bar -->
        <Border DockPanel.Dock="Top" Height="32"
                Background="{DynamicResource WindowBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Settings — TimeTrack"
                           FontFamily="Segoe UI" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button Grid.Column="1" Click="CloseButton_Click"
                        Width="36" Height="28" Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextBrush}" Cursor="Hand"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Close">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseBorder" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBorder" Property="Background" Value="#E81123"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Panel -->
        <Border x:Name="NavPanel" Grid.Column="0" Width="220"
                Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Hamburger + Title row -->
                <Grid DockPanel.Dock="Top" Margin="0,12,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnHamburger" Grid.Column="0"
                            Click="BtnHamburger_Click"
                            Width="36" Height="36"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextBrush}" Cursor="Hand"
                            Content="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                            ToolTip="Collapse/expand menu"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="HamburgerBorder" Background="{TemplateBinding Background}" Padding="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HamburgerBorder" Property="Background" Value="{DynamicResource NavButtonHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock x:Name="NavTitle" Grid.Column="1"
                               Text="Settings" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                </Grid>

                <StackPanel>
                    <RadioButton x:Name="GeneralTab" Content="General"
                                Tag="&#xE713;"
                                Style="{StaticResource NavButtonStyle}"
                                IsChecked="True"
                                Checked="NavButton_Checked"/>
                    <RadioButton x:Name="KeyboardTab" Content="Keyboard Shortcuts"
                                Tag="&#xE92E;"
                                Style="{StaticResource NavButtonStyle}"
                                Checked="NavButton_Checked"/>
                    <RadioButton x:Name="AppearanceTab" Content="Appearance"
                                Tag="&#xE790;"
                                Style="{StaticResource NavButtonStyle}"
                                Checked="NavButton_Checked"/>
                    <RadioButton x:Name="DataTab" Content="Data"
                                Tag="&#xE8B7;"
                                Style="{StaticResource NavButtonStyle}"
                                Checked="NavButton_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Right Content Panel -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="ContentPanel" Margin="24,12,24,24">
                    <!-- General Settings Panel -->
                    <StackPanel x:Name="GeneralPanel" Visibility="Visible">
                        <TextBlock Text="General Settings" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Configure general application settings and preferences."
                                  Style="{StaticResource SectionDescriptionStyle}"/>

                        <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                               BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Application Behavior" FontWeight="SemiBold"
                                          FontSize="14" Margin="0,0,0,12"/>

                                <CheckBox x:Name="ChkStartWithWindows" Content="Start with Windows"
                                         FontFamily="Segoe UI" FontSize="13" Margin="0,0,0,8"
                                         Foreground="{DynamicResource TextBrush}"/>

                                <CheckBox x:Name="ChkShowTrayIcon" Content="Show system tray icon"
                                         FontFamily="Segoe UI" FontSize="13" Margin="0,0,0,8"
                                         Foreground="{DynamicResource TextBrush}"
                                         IsChecked="True"/>

                                <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to system tray instead of taskbar"
                                         FontFamily="Segoe UI" FontSize="13" Margin="0,0,0,8"
                                         Foreground="{DynamicResource TextBrush}"
                                         IsChecked="True"/>

                                <CheckBox x:Name="ChkCloseToTray" Content="Close to system tray (keep running in background)"
                                         FontFamily="Segoe UI" FontSize="13" Margin="0,0,0,8"
                                         Foreground="{DynamicResource TextBrush}"
                                         IsChecked="False"/>

                                <CheckBox x:Name="ChkConfirmDelete" Content="Confirm before deleting entries"
                                         FontFamily="Segoe UI" FontSize="13" Margin="0,0,0,8"
                                         Foreground="{DynamicResource TextBrush}"
                                         IsChecked="True"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Keyboard Shortcuts Panel -->
                    <StackPanel x:Name="KeyboardPanel" Visibility="Collapsed">
                        <TextBlock Text="Keyboard Shortcuts" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Customize keyboard shortcuts for quick actions throughout the application."
                                  Style="{StaticResource SectionDescriptionStyle}"/>

                        <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                               BorderThickness="1" CornerRadius="8" Padding="8,4">
                            <ItemsControl x:Name="ShortcutsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="13"
                                                           Foreground="{DynamicResource TextBrush}"/>

                                                <Border Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                                                        Background="{DynamicResource NavButtonHoverBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        CornerRadius="4" Padding="10,2" MinWidth="90">
                                                    <TextBlock Text="{Binding DisplayText}" TextAlignment="Center"
                                                               FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                </Border>

                                                <Button Grid.Column="2" Content="Change..." Click="ChangeShortcut_Click"
                                                        Tag="{Binding ActionName}" Padding="10,2" Height="26"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Button Content="Reset to Defaults" Click="ResetDefaults_Click"
                               HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,6"/>
                    </StackPanel>

                    <!-- Appearance Panel -->
                    <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Customize the look and feel of the application."
                                  Style="{StaticResource SectionDescriptionStyle}"/>

                        <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                               BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Theme" FontWeight="SemiBold"
                                          FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Choose how TimeTrack looks. System Default follows your Windows colour preference."
                                          Foreground="{DynamicResource SubtleBrush}" FontSize="12"
                                          TextWrapping="Wrap" Margin="0,0,0,16"/>

                                <RadioButton x:Name="ThemeSystemDefault"
                                             Content="System Default"
                                             GroupName="ThemeGroup"
                                             FontFamily="Segoe UI" FontSize="13"
                                             Foreground="{DynamicResource TextBrush}"
                                             Margin="0,0,0,8"
                                             Checked="ThemeRadio_Checked"/>
                                <RadioButton x:Name="ThemeLight"
                                             Content="Light Mode"
                                             GroupName="ThemeGroup"
                                             FontFamily="Segoe UI" FontSize="13"
                                             Foreground="{DynamicResource TextBrush}"
                                             Margin="0,0,0,8"
                                             Checked="ThemeRadio_Checked"/>
                                <RadioButton x:Name="ThemeDark"
                                             Content="Dark Mode"
                                             GroupName="ThemeGroup"
                                             FontFamily="Segoe UI" FontSize="13"
                                             Foreground="{DynamicResource TextBrush}"
                                             Margin="0,0,0,8"
                                             Checked="ThemeRadio_Checked"/>
                                <RadioButton x:Name="ThemeMonokaiDimmed"
                                             Content="Monokai Dimmed"
                                             GroupName="ThemeGroup"
                                             FontFamily="Segoe UI" FontSize="13"
                                             Foreground="{DynamicResource TextBrush}"
                                             Margin="0,0,0,8"
                                             Checked="ThemeRadio_Checked"/>
                                <RadioButton x:Name="ThemeKimbieDark"
                                             Content="Kimbie Dark"
                                             GroupName="ThemeGroup"
                                             FontFamily="Segoe UI" FontSize="13"
                                             Foreground="{DynamicResource TextBrush}"
                                             Margin="0,0,0,8"
                                             Checked="ThemeRadio_Checked"/>
                                <RadioButton x:Name="ThemeSolarizedDark"
                                             Content="Solarized Dark"
                                             GroupName="ThemeGroup"
                                             FontFamily="Segoe UI" FontSize="13"
                                             Foreground="{DynamicResource TextBrush}"
                                             Margin="0,0,0,8"
                                             Checked="ThemeRadio_Checked"/>
                                <RadioButton x:Name="ThemeTomorrowNightBlue"
                                             Content="Tomorrow Night Blue"
                                             GroupName="ThemeGroup"
                                             FontFamily="Segoe UI" FontSize="13"
                                             Foreground="{DynamicResource TextBrush}"
                                             Checked="ThemeRadio_Checked"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Data Management Panel -->
                    <StackPanel x:Name="DataPanel" Visibility="Collapsed">
                        <TextBlock Text="Data Management" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Backup, restore, import, and export your TimeTrack database."
                                  Style="{StaticResource SectionDescriptionStyle}"/>

                        <!-- Quick Actions -->
                        <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                               BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Quick Actions" FontWeight="SemiBold"
                                          FontSize="14" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button Content="Create Backup Now" Click="CreateBackup_Click"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="16,6" Margin="0,0,8,0"/>
                                    <Button Content="Export Database..." Click="ExportDatabase_Click"
                                            Padding="16,6" Margin="0,0,8,0"/>
                                    <Button Content="Import Database..." Click="ImportDatabase_Click"
                                            Padding="16,6"/>
                                </StackPanel>
                                <TextBlock Text="A pre-restore backup is automatically created before any restore or import."
                                          Foreground="{DynamicResource SubtleBrush}" FontSize="12"
                                          TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Backup List -->
                        <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                               BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Available Backups" FontWeight="SemiBold"
                                          FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Select a backup and click Restore to roll back to that point."
                                          Foreground="{DynamicResource SubtleBrush}" FontSize="12"
                                          TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <ListView x:Name="BackupList" Height="200" Margin="0,0,0,12"
                                          Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                                          BorderThickness="1"
                                          SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayDate}"
                                                           FontFamily="Segoe UI" FontSize="13"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplaySize}"
                                                           FontFamily="Segoe UI" FontSize="12"
                                                           Foreground="{DynamicResource SubtleBrush}"
                                                           Margin="12,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource NavButtonSelectedBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource NavButtonHoverBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Restore Selected" Click="RestoreBackup_Click"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="16,6" Margin="0,0,8,0"/>
                                    <Button Content="Open Backup Folder" Click="OpenBackupFolder_Click"
                                            Padding="16,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Bottom Action Buttons -->
            <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="0,1,0,0" Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK" Click="OK_Click" IsDefault="True"
                           Style="{StaticResource PrimaryButton}"
                           Padding="24,6" Margin="0,0,8,0"/>
                    <Button Content="Cancel" Click="Cancel_Click" IsCancel="True" Padding="24,6"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </DockPanel>
</Window>