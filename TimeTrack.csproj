<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>TimeTrack.App</StartupObject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name for the built assembly -->
    <AssemblyName>TimeTrack</AssemblyName>
    <Product>TimeTrack v3</Product>
    <Company>TimeTrack Project</Company>
    <Authors>Jared Kinnear, Richard Moore</Authors>
    <Description>MSP time tracking with instant billable units calculation</Description>
    <Copyright>Copyright © 2020-2026</Copyright>

    <!-- Application icon and manifest -->
    <ApplicationIcon>Resources\Timetrack.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Version metadata -->
    <Version>3.0.5</Version>
    <AssemblyVersion>$(Version.Split('.')[0]).$(Version.Split('.')[1]).0.$(Version.Split('.')[2])</AssemblyVersion>

    <!-- Disable automatic Git version suffix -->
    <SourceRevisionId></SourceRevisionId>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Release-specific publish packaging settings -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Optimization -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded resources -->
    <Resource Include="Resources\Timetrack.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>
</Project>